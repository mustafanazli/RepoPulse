<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:repo="clr-namespace:RepoPulse.Core.Repositories;assembly=RepoPulse.Core"
             xmlns:local="clr-namespace:RepoPulse"
             x:Class="RepoPulse.RepositoryListPage"
             Title="Repositories">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Ayarlar"
            Clicked="OnSettingsClicked"
            Order="Primary" />
    </ContentPage.ToolbarItems>

    <CollectionView
        x:Name="RepositoryCollectionView"
        SelectionMode="Single"
        SelectionChanged="OnRepositoryItemSelected"
        SemanticProperties.Description="Repository listesi">

        <CollectionView.Header>
            <VerticalStackLayout Padding="30,20,30,10" Spacing="16">

                <Label
                    Text="Repositories"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Border
                    x:Name="RepositoryListTruncatedBanner"
                    IsVisible="False"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="Repository listesinin yalnızca bir bölümü gösteriliyor."
                        SemanticProperties.Description="Repository listesi kısmi olarak gösteriliyor uyarısı" />
                </Border>

                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                <Label
                    Text="GitHub'da Repository Aç"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2" />

                <Entry
                    x:Name="RepositoryInput"
                    Placeholder="owner/repository"
                    SemanticProperties.Hint="Aranacak GitHub repository adını owner/repository biçiminde girin" />

                <Button
                    x:Name="LookupButton"
                    Text="Repository'yi Getir"
                    Clicked="OnLookupRepositoryClicked"
                    SemanticProperties.Hint="Girilen repository bilgilerini GitHub'dan getirir"
                    HorizontalOptions="Fill" />

                <ActivityIndicator
                    x:Name="RepositoryLoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    SemanticProperties.Description="Repository bilgileri yükleniyor" />

                <Label
                    x:Name="RepositoryErrorLabel"
                    IsVisible="False"
                    TextColor="{AppThemeBinding Light=Crimson, Dark=OrangeRed}"
                    SemanticProperties.Description="Repository arama hatası" />

                <Border
                    x:Name="RepositoryCard"
                    IsVisible="False"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            x:Name="RepositoryFullNameLabel"
                            FontAttributes="Bold"
                            FontSize="18"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label x:Name="RepositoryStatsLabel" />
                        <Button
                            x:Name="ViewDetailButton"
                            Text="Detayları Gör"
                            Clicked="OnViewDetailClicked"
                            SemanticProperties.Hint="Bu repository'nin tüm ayrıntılarını gösterir"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                <Label
                    Text="Repository'lerim"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2" />

                <SearchBar
                    x:Name="RepositoryListSearchBar"
                    Placeholder="Listemde ara"
                    TextChanged="OnRepositoryListSearchTextChanged"
                    SemanticProperties.Hint="Yüklenmiş repository listesinde ada veya açıklamaya göre arama yapın" />

                <Picker
                    x:Name="RepositorySortPicker"
                    Title="Sırala"
                    SelectedIndex="0"
                    SelectedIndexChanged="OnRepositorySortOrderChanged"
                    SemanticProperties.Hint="Repository listesinin sıralama biçimini seçin">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Son güncellenen</x:String>
                            <x:String>Ada göre A-Z</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <!-- RP-012: "Tümü" shows the live GitHub list exactly as
                     RP-011 left it; "Favoriler" shows the SQLite-backed
                     favorite set (full card when the repo is also present
                     live, an identity-only row otherwise). A deliberate
                     ItemsSource swap on the single CollectionView below —
                     not a second CollectionView — so virtualization is
                     never doubled up. -->
                <Picker
                    x:Name="RepositoryViewFilterPicker"
                    Title="Görünüm"
                    SelectedIndex="0"
                    SelectedIndexChanged="OnRepositoryViewFilterChanged"
                    SemanticProperties.Hint="Tüm repository'ler veya yalnızca favoriler arasında seçim yapın">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Tümü</x:String>
                            <x:String>Favoriler</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <!-- Non-blocking: a failed favorite toggle or a failed
                     on-demand fetch from an offline favorite row shows a
                     short safe message here without touching the list's own
                     loading/empty/error labels below, so the list itself
                     keeps working regardless. -->
                <Label
                    x:Name="FavoriteToggleErrorLabel"
                    IsVisible="False"
                    TextColor="{AppThemeBinding Light=Crimson, Dark=OrangeRed}"
                    SemanticProperties.Description="Favori işlemi hatası" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="30,10" Spacing="12">
                <ActivityIndicator
                    x:Name="RepositoryListLoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    SemanticProperties.Description="Repository listesi yükleniyor" />
                <Label
                    x:Name="RepositoryListEmptyLabel"
                    IsVisible="False"
                    Text="Henüz görüntülenecek repository bulunamadı."
                    SemanticProperties.Description="Repository listesi boş" />
                <Label
                    x:Name="RepositoryListNoMatchesLabel"
                    IsVisible="False"
                    Text="Eşleşen repository bulunamadı."
                    SemanticProperties.Description="Aramayla eşleşen repository bulunamadı" />
                <Label
                    x:Name="RepositoryListErrorLabel"
                    IsVisible="False"
                    TextColor="{AppThemeBinding Light=Crimson, Dark=OrangeRed}"
                    SemanticProperties.Description="Repository listesi yükleme hatası" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <local:RepositoryListRowTemplateSelector>
                <local:RepositoryListRowTemplateSelector.RepositoryTemplate>
                    <DataTemplate x:DataType="repo:RepositoryListItem">
                        <Border Margin="30,0,30,12" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding FullName}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    SemanticProperties.HeadingLevel="Level2" />
                                <Label
                                    Text="{Binding Description}"
                                    IsVisible="{Binding HasDescription}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding StatsText}" />
                                <Label
                                    Text="{Binding LanguageText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label
                                    Text="{Binding UpdatedText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label
                                    Text="{Binding BadgeText}"
                                    IsVisible="{Binding HasBadge}"
                                    FontAttributes="Italic" />
                                <Button
                                    Text="{Binding FavoriteToggleLabel}"
                                    Clicked="OnFavoriteToggleClicked"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Hint="Bu repository'yi favorilere ekler veya favorilerden çıkarır" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </local:RepositoryListRowTemplateSelector.RepositoryTemplate>
                <local:RepositoryListRowTemplateSelector.FavoriteIdentityTemplate>
                    <DataTemplate x:DataType="repo:FavoriteIdentityRow">
                        <Border Margin="30,0,30,12" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding FullName}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    SemanticProperties.HeadingLevel="Level2" />
                                <Label
                                    Text="{Binding AddedAtText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label
                                    Text="Ayrıntılar için bağlantı gerekli."
                                    FontAttributes="Italic"
                                    SemanticProperties.Description="Bu favori şu anda yalnızca kimlik bilgisiyle gösteriliyor" />
                                <Button
                                    Text="Favorilerden çıkar"
                                    Clicked="OnFavoriteToggleClicked"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Hint="Bu repository'yi favorilerden çıkarır" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </local:RepositoryListRowTemplateSelector.FavoriteIdentityTemplate>
            </local:RepositoryListRowTemplateSelector>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
