<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepoPulse.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="20">

            <Label
                Text="RepoPulse"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <!-- Signed-out state: GitHub sign-in entry point. -->
            <Button
                x:Name="SignInButton"
                Text="GitHub ile giriş yap"
                Clicked="OnSignInClicked"
                SemanticProperties.Hint="GitHub hesabınızla giriş yapmak için tarayıcıyı açar"
                HorizontalOptions="Fill" />

            <Label
                x:Name="OAuthCallbackStatusLabel"
                IsVisible="False"
                SemanticProperties.Description="Giriş durumu" />

            <!-- Signed-in state: avatar + login. -->
            <HorizontalStackLayout
                x:Name="SignedInHeader"
                IsVisible="False"
                Spacing="12">
                <Image
                    x:Name="GitHubAvatarImage"
                    HeightRequest="48"
                    WidthRequest="48"
                    Aspect="AspectFill"
                    SemanticProperties.Description="GitHub profil fotoğrafı" />
                <Label
                    x:Name="GitHubLoginLabel"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Repository lookup — only shown once signed in. -->
            <VerticalStackLayout
                x:Name="RepositoryLookupSection"
                IsVisible="False"
                Spacing="12">

                <BoxView
                    HeightRequest="1"
                    HorizontalOptions="Fill" />

                <Label
                    Text="Repository Ara"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2" />

                <Entry
                    x:Name="RepositoryInput"
                    Placeholder="owner/repository"
                    SemanticProperties.Hint="Aranacak GitHub repository adını owner/repository biçiminde girin" />

                <Button
                    x:Name="LookupButton"
                    Text="Repository'yi Getir"
                    Clicked="OnLookupRepositoryClicked"
                    SemanticProperties.Hint="Girilen repository bilgilerini GitHub'dan getirir"
                    HorizontalOptions="Fill" />

                <ActivityIndicator
                    x:Name="RepositoryLoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    SemanticProperties.Description="Repository bilgileri yükleniyor" />

                <Label
                    x:Name="RepositoryErrorLabel"
                    IsVisible="False"
                    TextColor="{AppThemeBinding Light=Crimson, Dark=OrangeRed}"
                    SemanticProperties.Description="Repository arama hatası" />

                <Border
                    x:Name="RepositoryCard"
                    IsVisible="False"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            x:Name="RepositoryFullNameLabel"
                            FontAttributes="Bold"
                            FontSize="18"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label x:Name="RepositoryDescriptionLabel" />
                        <Label x:Name="RepositoryStatsLabel" />
                        <Label x:Name="RepositoryLanguageLabel" />
                        <Label x:Name="RepositoryUpdatedLabel" />
                        <Label
                            x:Name="RepositoryBadgesLabel"
                            IsVisible="False"
                            FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
